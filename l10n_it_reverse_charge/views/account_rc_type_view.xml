<odoo>

    <record id="view_rc_type_form" model="ir.ui.view">
        <field name="name">account.rc.type.form</field>
        <field name="model">account.rc.type</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Reverse Charge Type">
                <group>
                    <group string="Main Informations">
                        <field name="name"/>
                        <field name="method"/>
                        <field name="description"/>
                        <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                    </group>
                    <group string="Self Invoicing">
                        <!-- Nota l'uso degli apici singoli ' invece di &quot; -->
                        <field name="partner_type"
                               readonly="method != 'selfinvoice'"
                               required="method == 'selfinvoice'"/>

                        <field name="with_supplier_self_invoice"
                               invisible="partner_type != 'other' or method != 'selfinvoice'"/>

                        <field name="partner_id"
                               readonly="method != 'selfinvoice'"
                               invisible="partner_type != 'other'"
                               required="partner_type == 'other'"/>

                        <field name="journal_id"
                               readonly="method != 'selfinvoice'"
                               required="method == 'selfinvoice'"/>

                        <field name="supplier_journal_id"
                               invisible="method != 'selfinvoice' or partner_type != 'other' or not with_supplier_self_invoice"
                               required="with_supplier_self_invoice"/>

                        <field name="payment_journal_id"
                               readonly="method != 'selfinvoice'"
                               required="method == 'selfinvoice'"/>

                        <field name="transitory_account_id"
                               readonly="method != 'selfinvoice'"
                               required="method == 'selfinvoice'"/>

                        <!-- Rimosso widget="one2many_list" -->
                        <field name="tax_ids"
                               readonly="method != 'selfinvoice'"
                               required="method == 'selfinvoice'">
                            <list editable="bottom">
                                <field name="original_purchase_tax_id"/>
                                <field name="purchase_tax_id"/>
                                <field name="sale_tax_id"/>
                            </list>
                        </field>
                    </group>
                    <group string="Text on Self Invoice">
                        <field name="self_invoice_text" readonly="method != 'selfinvoice'"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="view_rc_type_list" model="ir.ui.view">
        <field name="name">account.rc.type.list</field>
        <field name="model">account.rc.type</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="method"/>
                <field name="partner_type"/>
                <field name="journal_id"/>
                <field name="payment_journal_id"/>
            </list>
        </field>
    </record>

    <record id="action_rc_type" model="ir.actions.act_window">
        <field name="name">Reverse Charge Types</field>
        <field name="res_model">account.rc.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem action="action_rc_type" id="menu_action_rc_type" sequence="20" parent="account.account_account_menu"
              groups="account.group_account_manager"/>

</odoo>
