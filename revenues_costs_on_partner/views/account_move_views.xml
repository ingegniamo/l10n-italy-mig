<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View account.move.line form -->
    <record id="view_account_move_line_form" model="ir.ui.view">
        <field name="name">view.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']//tree" position="inside">
                <field name="domain_account_ids"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//tree" position="inside">
                <field name="domain_account_ids"/>
            </xpath>
              <xpath expr="//field[@name='line_ids']//tree//field[@name='account_id']" position="attributes">
                <attribute name="domain">domain_account_ids</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='account_id']" position="attributes">
                <attribute name="domain">domain_account_ids</attribute>
            </xpath>
        </field>
    </record>

</odoo>