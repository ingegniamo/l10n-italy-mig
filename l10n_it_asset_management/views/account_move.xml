<odoo>

    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">view.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="hide_link_asset_button" invisible="1" />
                <button name="open_wizard_manage_asset" type="object" string="Link to Asset" groups="l10n_it_asset_management.group_asset_user" class="oe_highlight" invisible="hide_link_asset_button == True" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="assets" groups="l10n_it_asset_management.group_asset_user" string="Assets">
                    <field name="asset_ids" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_form_inherit" model="ir.ui.view">
        <field name="name">view.move.line.form.inherit</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="assets" string="Assets">
                    <group name="assets_info" string="Assets" groups="l10n_it_asset_management.group_asset_user">
                        <field name="asset_ids" nolabel="1"/>
                    </group>
                    <group name="dep_lines_info" string="Depreciation Lines" groups="l10n_it_asset_management.group_asset_user">
                        <field name="dep_line_ids" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>